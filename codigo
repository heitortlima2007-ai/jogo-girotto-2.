void iniciarFase2(char mapa[15][15], int *pL, int *pC, int *mL, int *mC) {
    int i, j;
    *pL=1; *pC=1; *mL=9; *mC=9;
    for(i=0; i<15; i++) 
        for(j=0; j<15; j++) 
            mapa[i][j] = (i==0 || i==14 || j==0 || j==14) ? '*' : '.';
            
    for(j=3; j<=8; j++) mapa[5][j]='*';
    for(j=6; j<=11; j++) mapa[10][j]='*';
    mapa[2][5]='@'; mapa[8][10]='@'; mapa[5][9]='D'; mapa[10][5]='D';
    mapa[3][3]='#'; mapa[3][4]='#'; mapa[7][7]='O'; mapa[12][12]='L';
    mapa[*mL][*mC]='X'; mapa[*pL][*pC]='^';
}

