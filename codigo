                                if(f3[f3i][f3j]=='Y'&&y1){f3[f3i][f3j]='.';y1=0;printf("Monstro Y derrotado!\n");}
                                if(f3[f3i][f3j]=='Z'&&bAtivo){
                                    bVidas--; printf("Boss atingido! Vidas boss:%d\n", bVidas);
                                    if(bVidas<=0){ f3[f3i][f3j]='.'; bAtivo=0; f3[23][23]='L'; printf("BOSS DERROTADO! Va ate L para vencer!\n"); }
                                }
                            }
                        }
                    }
                    continue;
                }
                
                if(f3nl<0||f3nl>=25||f3nc<0||f3nc>=25) continue;
                if(f3[f3nl][f3nc]=='*'||f3[f3nl][f3nc]=='D') {printf("Caminho bloqueado!\n");continue;}
                if(f3[f3nl][f3nc]=='k') {printf("Ha uma caixa!\n");continue;}
                if(f3[f3nl][f3nc]=='#'){
                    printf("Espinho! -1 vida.\n"); vidas--;
                    if(vidas<=0){telaGameOver();menu=0;vidas=3;arma=0;break;}
                    iniciarFase3(f3, &f3L, &f3C, &x1L, &x1C, &y1L, &y1C, &bL, &bC); x1=1;y1=1;bAtivo=1;bVidas=3;chaves3=0;portas3=0;f3dir=0;turno=0;continue;
                }
                if((f3[f3nl][f3nc]=='X'&&x1)||(f3[f3nl][f3nc]=='Y'&&y1)||(f3[f3nl][f3nc]=='Z'&&bAtivo)){
                    printf("Monstro! -1 vida.\n"); vidas--;
                    if(vidas<=0){telaGameOver();menu=0;vidas=3;arma=0;break;}
                    iniciarFase3(f3, &f3L, &f3C, &x1L, &x1C, &y1L, &y1C, &bL, &bC); x1=1;y1=1;bAtivo=1;bVidas=3;chaves3=0;portas3=0;f3dir=0;turno=0;continue;
                }
                
                f3[f3L][f3C]='.'; f3L=f3nl; f3C=f3nc;
                f3[f3L][f3C] = (f3dir==0)?'^':(f3dir==1)?'v':(f3dir==2)?'<':'>';
                
                turno++;
                if(x1) moverX(25, 25, f3, &x1L, &x1C);
                if(y1) moverY(25, 25, f3, &y1L, &y1C, f3L, f3C);
                if(bAtivo) moverBoss(25, 25, f3, &bL, &bC, f3L, f3C, turno);
                
                if((x1&&x1L==f3L&&x1C==f3C)||(y1&&y1L==f3L&&y1C==f3C)||(bAtivo&&bL==f3L&&bC==f3C)){
                    printf("Monstro te alcancou! -1 vida.\n"); vidas--;
                    if(vidas<=0){telaGameOver();menu=0;vidas=3;arma=0;break;}
                    iniciarFase3(f3, &f3L, &f3C, &x1L, &x1C, &y1L, &y1C, &bL, &bC); x1=1;y1=1;bAtivo=1;bVidas=3;chaves3=0;portas3=0;f3dir=0;turno=0;
                }
            }
        }
    }
    return 0;
}
