int celulaAtingida(int pL, int pC, int dir, int arma, int al, int ac) {
    int k;
    if(arma==1){ 
        if(dir==0) return(al>=pL-2 && al<=pL-1 && ac>=pC-1 && ac<=pC+1);
        if(dir==1) return(al>=pL+1 && al<=pL+2 && ac>=pC-1 && ac<=pC+1);
        if(dir==2) return(ac>=pC-2 && ac<=pC-1 && al>=pL-1 && al<=pL+1);
        return(ac>=pC+1 && ac<=pC+2 && al>=pL-1 && al<=pL+1);
    }
    if(arma==2){ 
        for(k=1; k<=4; k++){
            if(dir==0 && al==pL-k && ac==pC) return 1;
            if(dir==1 && al==pL+k && ac==pC) return 1;
            if(dir==2 && ac==pC-k && al==pL) return 1;
            if(dir==3 && ac==pC+k && al==pL) return 1;
        }
        return 0;
    } 
    if(arma==3){ 
        return(al>=pL-1 && al<=pL+1 && ac>=pC-1 && ac<=pC+1 && !(al==pL && ac==pC));
    }
    return 0;
}


void moverX(int lins, int cols, char mapa[lins][cols], int *mL, int *mC) {
    int dir=rand()%4, nl=*mL, nc=*mC; char cel;
    if(dir==0) nl--; else if(dir==1) nl++; else if(dir==2) nc--; else nc++;
    if(nl<0 || nl>=lins || nc<0 || nc>=cols) return;
    cel=mapa[nl][nc];
    if(cel=='*' || cel=='k' || cel=='D' || cel=='#' || cel=='L' || cel=='O') return;
    mapa[*mL][*mC]='.'; *mL=nl; *mC=nc; mapa[nl][nc]='X';
}

void moverY(int lins, int cols, char mapa[lins][cols], int *mL, int *mC, int pL, int pC) {
    int nl=*mL, nc=*mC, dl=pL-*mL, dc=pC-*mC; char cel;
    int adl=dl<0?-dl:dl, adc=dc<0?-dc:dc;
    if(adl>=adc) nl+=(pL>*mL)?1:-1; else nc+=(pC>*mC)?1:-1;
    if(nl<0 || nl>=lins || nc<0 || nc>=cols) return;
    cel=mapa[nl][nc];
    if(cel=='*' || cel=='k' || cel=='D' || cel=='#' || cel=='L' || cel=='O') return;
    mapa[*mL][*mC]='.'; *mL=nl; *mC=nc; mapa[nl][nc]='Y';
}

void moverBoss(int lins, int cols, char mapa[lins][cols], int *bL, int *bC, int pL, int pC, int turno) {
    int nl=*bL, nc=*bC; char cel;
    if(turno%3==0){ nl+=(pL>*bL)?1:-1; nc+=(pC>*bC)?1:-1; }
    else { 
        int dl=pL-*bL, dc=pC-*bC, adl=dl<0?-dl:dl, adc=dc<0?-dc:dc;
        if(adl>=adc) nl+=(dl>0)?1:-1; else nc+=(dc>0)?1:-1; 
    }
    if(nl<0 || nl>=lins || nc<0 || nc>=cols) return;
    cel=mapa[nl][nc];
    if(cel=='*' || cel=='k' || cel=='D' || cel=='L' || cel=='O') return;
    mapa[*bL][*bC]='.'; *bL=nl; *bC=nc; mapa[nl][nc]='Z';
}

